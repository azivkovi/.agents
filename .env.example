# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#
# Sentry self-hosted instance: https://sentry.regulus.systems
# Create a User Auth Token at:
#   https://sentry.regulus.systems/settings/account/api/auth-tokens/
# Required scopes: org:read, project:read, event:read, event:write (for
# resolving/updating issues), member:read.
SENTRY_ACCESS_TOKEN=replace-with-your-sentry-token

# Optional. Overrides the host in bin/sentry-mcp.sh (default sentry.regulus.systems).
SENTRY_HOST=sentry.regulus.systems
